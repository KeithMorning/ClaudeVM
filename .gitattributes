# 仓库内统一 LF：运行时脚本要在 Linux 里执行，CRLF 会让 shebang 变成 "bash\r"
* text=auto eol=lf

*.sh      text eol=lf
*.py      text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.xml     text eol=lf
*.md      text eol=lf
*.conf    text eol=lf
*.desktop text eol=lf
*.txt     text eol=lf

# Windows 专用脚本保留 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制资源
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.zip   binary
*.png   binary
*.jpg   binary
*.ico   binary
*.exe   binary
*.dll   binary
*.asar  binary
*.gz    binary
